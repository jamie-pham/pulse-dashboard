# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.
# Every source is optional — anything left blank just shows as "not set up".

# --- Basics ---------------------------------------------------------------
APP_URL=http://localhost:3000            # your Vercel URL in production, e.g. https://pulse-jamie.vercel.app
DASHBOARD_PASSWORD=                      # the password you'll type on your phone
SESSION_SECRET=                          # any long random string: `openssl rand -hex 32`
TIMEZONE=Australia/Melbourne
OWNER_NAME=Jamie
DEMO_MODE=1                              # 1 = fake data so you can see the UI. Set to 0 once things are connected.

# --- Personal assistant ---------------------------------------------------
BRIEF_TOKEN=                             # random string; the iOS alarm Shortcut sends it to read your brief aloud
HOME_LAT=-37.835                         # weather + nearby-emergency checks (or tap 📍 in the app to use your phone)
HOME_LON=144.73
HOME_LABEL=Home
CAMPUS_LAT=-37.9105                      # Monash Clayton — shows campus weather for your first class
CAMPUS_LON=145.134
TRAVEL_CAMPUS_MIN=60                     # door-to-door minutes, for "leave by" times
TRAVEL_SHIFT_MIN=30
TRAVEL_OTHER_MIN=30
GET_READY_MIN=30                         # wake → out the door
MORNING_ROUTINE=Water,Check today's plan,10 min stretch,Protein breakfast
COUNTDOWNS=                              # e.g. Exams start:2026-11-02,Security+ exam:2026-12-12
ALERT_RADIUS_KM=15                       # VicEmergency incidents this close (warnings: 3× this). ALERTS=off to hide.

# --- Strain model ---------------------------------------------------------
AGE=19                                   # used to estimate max HR (208 − 0.7 × age) if HR_MAX isn't set
HR_MAX=                                  # your real max HR if you know it — makes strain more accurate
SEX=male                                 # male | female — changes the TRIMP weighting
SLEEP_NEED_MIN=480                       # base sleep need, minutes
DEFAULT_WAKE=07:30                       # used for tonight's bedtime when nothing's on tomorrow morning

# --- Storage (required on Vercel) -----------------------------------------
# Add the Upstash Redis integration in Vercel → Storage; it fills these in for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google: Fitbit Air (Google Health API) + Calendar + Gmail ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_IDS=primary              # comma-separated if you want more calendars

# --- Tanda (play centre shifts) -------------------------------------------
TANDA_TOKEN=

# --- Monash ---------------------------------------------------------------
MOODLE_ICS_URL=                          # Moodle → Calendar → Export calendar → Get calendar URL
TIMETABLE_ICS_URL=                       # MyTimetable / Allocate+ → calendar subscription link
ED_TOKEN=                                # edstem.org/au/settings/api-tokens
ED_BASE=https://au.edstem.org/api
ED_COURSE_IDS=                           # optional, e.g. 37681 — blank = all active courses
ONTRACK_BASE=                            # e.g. https://ontrack.infotech.monash.edu/api (check in devtools)
ONTRACK_USERNAME=
ONTRACK_AUTH_TOKEN=

# --- Work -----------------------------------------------------------------
NOTION_TOKEN=                            # notion.so/my-integrations → internal integration secret
NOTION_DATABASE_ID=                      # the tasks database (share it with the integration!)
NOTION_DATE_PROP=Due
NOTION_STATUS_PROP=Status
NOTION_DONE_VALUES=Done,Complete
GITHUB_TOKEN=                            # fine-grained PAT, read-only: Issues + Pull requests + Metadata
GITHUB_REPOS=                            # e.g. your-org/anchor-app,your-org/anchor-api
